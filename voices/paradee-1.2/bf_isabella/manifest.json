   "bytes": 46653,
   "sha256": "bcbe79164646386a73d10621a77e0666abac6ab32224113b4fecba9e7f47958d",
   "seconds": 7.38,
   "text": "Let your hips sink gently forward. Keep your front knee above your ankle, and breathe."
  },
  "warrior-left.first": {
