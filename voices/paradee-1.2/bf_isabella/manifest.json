   "sha256": "fdcc99d156134bdda7be31694f9eb3ed11b5a1c8db1b30be675d4d74f9cabbb9",
   "seconds": 3.67,
   "text": "Let's begin with warrior two, left side."
  },
  "warrior-left.next": {
   "file": "warrior-left.next.m4a",
   "bytes": 20543,
   "sha256": "06066887d94a9f15da558b07262d9a14c98d261dc2c57373cb7f2c2e1f03b344",
   "seconds": 3.27,
   "text": "Next, warrior two, left side."
  },
  "warrior-left.now": {
