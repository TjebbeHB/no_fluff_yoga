   "sha256": "08e6c9e5ef67f14ef9446273856f50f277620ece55f97b37b94210c4c5316091",
   "seconds": 15.12,
   "text": "Warrior two, left side. Step your feet wide apart. Turn your left foot out and bend your left knee over your ankle. Stretch both arms out wide, and look past your left hand."
  },
  "warrior-left.hold": {
   "file": "warrior-left.hold.m4a",
   "bytes": 48451,
   "sha256": "68b040e7c9cc2fbcb2d74dd54782999eeb4b1cf46e288305a89fa2d4494ff4dd",
   "seconds": 7.66,
   "text": "Press into the outer edge of your back foot. Keep your shoulders relaxed, and breathe steadily."
  },
  "warrior-right.first": {
   "file": "warrior-right.first.m4a",
   "bytes": 23279,
   "sha256": "6fc12eb93c5746ad4a843fffe6d5ec4ea76f2e667162fdc3eb00f9219538032b",
   "seconds": 3.69,
   "text": "Let's begin with warrior two, right side."
  },
  "warrior-right.next": {
   "file": "warrior-right.next.m4a",
   "bytes": 20985,
   "sha256": "6965f5fd36e11955c6d7b34a74e98df70255b500b1ffecf8e5daef13c108cafd",
   "seconds": 3.32,
   "text": "Next, warrior two, right side."
  },
  "warrior-right.now": {
   "file": "warrior-right.now.m4a",
   "bytes": 21029,
   "sha256": "ebf99aaca828e85226ce124e1937724856af636e75fa23caf506b279d4c98a7e",
   "seconds": 3.22,
   "text": "Now, warrior two, right side."
  },
  "warrior-right.enter": {
