   "sha256": "6f7516c0d88beceb162ecfe589f2043aa4474020ca401e24bbbde54d50db46ef",
   "seconds": 15.49,
   "text": "Warrior two, right side. Step your feet wide apart. Turn your right foot out and bend your right knee over your ankle. Stretch both arms out wide, and look past your right hand."
  },
  "warrior-right.hold": {
   "file": "warrior-right.hold.m4a",
   "bytes": 49994,
   "sha256": "62a5c239f51101700d1f5dc5f753fb4a6daa935cf0796c61abb44b7c10289288",
   "seconds": 7.66,
   "text": "Press into the outer edge of your back foot. Keep your shoulders relaxed, and breathe steadily."
  },
  "triangle-left.first": {
   "file": "triangle-left.first.m4a",
   "bytes": 27003,
   "sha256": "a2094d4aeaa0698fdad5cc30768b082d8a0f5d076bbd4e8de4aac2098455be03",
   "seconds": 4.07,
   "text": "Let's begin with triangle pose, left side."
  },
  "triangle-left.next": {
   "file": "triangle-left.next.m4a",
   "bytes": 22705,
   "sha256": "02f07e35fc174f9cdfb27892153382a75149eb8e7537fd53f0254e3f407b1b69",
   "seconds": 3.6,
   "text": "Next, triangle pose, left side."
  },
  "triangle-left.now": {
   "file": "triangle-left.now.m4a",
