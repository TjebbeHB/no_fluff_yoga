   "bytes": 76624,
   "sha256": "ebd10baf96d31a0a7681f33b60e1439b76f3f10c5ed2668d586c7caf90d95bfb",
   "seconds": 12.45,
   "text": "Low lunge, right side. Step your right foot forward between your hands, and lower your left knee onto the mat, with some padding if you like. Lift your chest."
  },
  "lunge-right.hold": {
