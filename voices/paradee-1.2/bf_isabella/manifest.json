{
 "format": 1,
 "model": "Paradee 1.2 (Apache-2.0), distilled from Kokoro-82M",
 "voice": "bf_isabella",
 "bytes": 3802986,
 "lines": {
  "intro": {
   "file": "intro.m4a",
   "bytes": 40488,
   "sha256": "7d9760ab3261fab48c05e6bc57953bc2fb4bdac2fe6a0abda4317db4329961e1",
   "seconds": 6.63,
   "text": "Welcome. Find a comfortable spot on your mat, and let your breath settle."
  },
  "outro": {
   "file": "outro.m4a",
   "bytes": 65643,
   "sha256": "c046e9d213a437605996234db4024e78a54e75e5e1bf58fc7d323fc3b2403b75",
   "seconds": 10.4,
   "text": "That's the end of your practice. Stay here as long as you like. When you're ready, roll onto your side and come up slowly."
  },
  "outro.brief": {
   "file": "outro.brief.m4a",
   "bytes": 26730,
   "sha256": "0c1bb1fbc5de9f31c0fc3a24bf2c515508964996892bfa8174e008f1d5eff8cb",
   "seconds": 4.51,
   "text": "That's your practice. Well done."
  },
  "switch": {
   "file": "switch.m4a",
   "bytes": 22807,
   "sha256": "7c6c0be53711e0c52f406968209a50fe2d058ceed86b7a969ebedf2492384126",
   "seconds": 3.69,
   "text": "Gently release, and let's do the other side."
  },
  "switch.brief": {
   "file": "switch.brief.m4a",
   "bytes": 15277,
   "sha256": "26d41ce9e713b5348e82d9452912706aba0b3f849a83d0f4559a72fd02f21f1d",
   "seconds": 2.5,
   "text": "Now the other side."
  },
  "breaths.0": {
   "file": "breaths.0.m4a",
   "bytes": 17514,
   "sha256": "d8b4c5c051e6bd45c8963a414c5c30b27422b542401dc576455fdb922c01e6e6",
   "seconds": 2.87,
   "text": "Stay for a few more breaths."
  },
  "breaths.1": {
   "file": "breaths.1.m4a",
   "bytes": 18795,
   "sha256": "ce8c15b08a13f7e390bf1453be64fda0a85399207c0e1179e469ece6e13d3214",
   "seconds": 2.97,
   "text": "Two more slow breaths here."
  },
  "breaths.2": {
   "file": "breaths.2.m4a",
   "bytes": 36486,
   "sha256": "60bd5fbbaa7f6031d028ddeabf4477dfe366a5fec6a8f840342b4ebbd9dd2cbf",
   "seconds": 5.31,
   "text": "Just a little longer. Keep breathing softly."
  },
  "sample": {
   "file": "sample.m4a",
   "bytes": 36845,
   "sha256": "028eac4363513d326b789c42c3eb3a937a366c22335c191bf630ee3c0efb7731",
   "seconds": 5.88,
   "text": "Hello. I'll guide you through your practice, one pose at a time."
  },
  "mountain.first": {
   "file": "mountain.first.m4a",
   "bytes": 21840,
   "sha256": "1e250dbe7a2fa4f36914943b08527db23dd1f7dd8af95587a605acaf7c7d44b9",
   "seconds": 3.29,
   "text": "Let's begin with mountain pose."
  },
  "mountain.next": {
   "file": "mountain.next.m4a",
   "bytes": 17615,
   "sha256": "d71ae0e8c715f2693e295602d135d9dd9b6fa1002d73e09ab903b18ed0ee860c",
   "seconds": 2.9,
   "text": "Next, mountain pose."
  },
  "mountain.now": {
   "file": "mountain.now.m4a",
   "bytes": 17098,
   "sha256": "dd49bdc24e120b55807ee48db7a19637ad7cd531e8e69ee1826d03f6c0e322cb",
   "seconds": 2.82,
   "text": "Now, mountain pose."
  },
  "mountain.enter": {
   "file": "mountain.enter.m4a",
   "bytes": 74857,
   "sha256": "0c86238426e7b3182877848494bacc59a6e6369e977cc6d4132fe85f62c8aa5c",
   "seconds": 11.95,
   "text": "Mountain pose. Come to stand with your feet about hip-width apart and your arms resting by your sides. Lengthen up through the top of your head."
  },
  "mountain.hold": {
   "file": "mountain.hold.m4a",
   "bytes": 49767,
   "sha256": "519a7ecd6c938be0717c9c6622fbac98ac6f45cf33b70894650473a135076191",
   "seconds": 7.99,
   "text": "Feel your feet grounded on the mat. Soften your knees, let your shoulders settle, and breathe slowly."
  },
  "reach.first": {
   "file": "reach.first.m4a",
   "bytes": 19381,
   "sha256": "ed83003f195296869b6be6e6f66b66e425b0aca84bebfc7a1833e8443cff1ea9",
   "seconds": 3.12,
   "text": "Let's begin with upward reach."
  },
  "reach.next": {
   "file": "reach.next.m4a",
   "bytes": 16813,
   "sha256": "f09b498c1089c5ee6a574dc712c45bf2dfb68e0ce75053307ff05cf9c0666d05",
   "seconds": 2.69,
   "text": "Next, upward reach."
  },
  "reach.now": {
   "file": "reach.now.m4a",
   "bytes": 16271,
   "sha256": "1b5822f69eba6e081a6becd04ea5b7380e434062c414058b9514149b678beb97",
   "seconds": 2.62,
   "text": "Now, upward reach."
  },
  "reach.enter": {
   "file": "reach.enter.m4a",
   "bytes": 67110,
   "sha256": "816853728882d9b45a707b46c1cd5d22fe9200665d5b16f1cc541020bf6bfe06",
   "seconds": 10.78,
   "text": "Upward reach. Breathing in, sweep both arms out to the sides and up toward the sky. Reach gently through your fingertips."
  },
  "reach.hold": {
   "file": "reach.hold.m4a",
   "bytes": 47902,
   "sha256": "8bab5b19c3107be4446999b5ee48011c9b50ba93da3cf95459573a170a04409f",
   "seconds": 7.54,
   "text": "Keep your shoulders soft and away from your ears. Let your ribs stay easy as you breathe."
  },
  "fold.first": {
   "file": "fold.first.m4a",
   "bytes": 20763,
   "sha256": "7cf9f68c5e9fd9f4ba68543566ad563ef385db04ff20185d3d399440fc2131f9",
   "seconds": 3.32,
   "text": "Let's begin with standing fold."
  },
  "fold.next": {
   "file": "fold.next.m4a",
   "bytes": 17582,
   "sha256": "41306cbe4e71827964c4984fbbb43db9e6c7dfa50fb71c0089b0d0dcb06ba544",
   "seconds": 2.87,
   "text": "Next, standing fold."
  },
  "fold.now": {
   "file": "fold.now.m4a",
   "bytes": 17170,
   "sha256": "ec3f7948ab95a789160b8f046cf43093672fa7b845e10baebbf389a849ba9007",
   "seconds": 2.82,
   "text": "Now, standing fold."
  },
  "fold.enter": {
   "file": "fold.enter.m4a",
   "bytes": 62117,
   "sha256": "ff16dc2c3754cde69a043f252936eca6c1400884640f0f30e290ed4c0e16de24",
   "seconds": 10.12,
   "text": "Standing fold. Soften your knees and hinge forward from your hips. Let your upper body hang down toward the mat."
  },
  "fold.hold": {
   "file": "fold.hold.m4a",
   "bytes": 44723,
   "sha256": "9a15170bc00543f7b255894338f10008cfc3d8e4dd191305968f75f6b8a0fdf4",
   "seconds": 7.11,
   "text": "Let your head feel heavy and your arms dangle. Bend your knees as much as you like."
  },
  "seated.first": {
   "file": "seated.first.m4a",
   "bytes": 19454,
   "sha256": "e159ec75957df49914762c4351c36e85941fa36d73eb2bc1d186b3ca44ab10b2",
   "seconds": 3.15,
   "text": "Let's begin with easy seat."
  },
  "seated.next": {
   "file": "seated.next.m4a",
   "bytes": 16256,
   "sha256": "00e15980df9b603363882147530a61bafd63ebebe8bcfc677d307ab71f8f8c8e",
   "seconds": 2.62,
   "text": "Next, easy seat."
  },
  "seated.now": {
   "file": "seated.now.m4a",
   "bytes": 15124,
   "sha256": "3537c9a2fc97911c1144b49bfe1ebe52c2abe0328947e0749c61e8aa2dcb8943",
   "seconds": 2.52,
   "text": "Now, easy seat."
  },
  "seated.enter": {
   "file": "seated.enter.m4a",
   "bytes": 65012,
   "sha256": "c44b8b7152a0e193de56151f45ef4097a1b3a223af2fa3df9c981a80a8111f76",
   "seconds": 10.1,
   "text": "Easy seat. Come down to sit on your mat and cross your legs comfortably. A cushion under your hips can help."
  },
  "seated.hold": {
   "file": "seated.hold.m4a",
   "bytes": 47245,
   "sha256": "baa5b5fddd4c8e54ac16584b9ca7817cbcc0a2cc207013bef0300ffa084fac05",
   "seconds": 7.63,
   "text": "Lengthen through your spine and rest your hands on your knees. Let each breath slow down."
  },
  "child.first": {
   "file": "child.first.m4a",
   "bytes": 20251,
   "sha256": "f37b47491fd9bd90f08867036a7232a7c11d736b98579a3873b7c69d990d021f",
   "seconds": 3.25,
   "text": "Let's begin with child's pose."
  },
  "child.next": {
   "file": "child.next.m4a",
   "bytes": 17217,
   "sha256": "83ae3603cd370ff523e45ee064105146fc89066604e1090e38a0d76818613a8f",
   "seconds": 2.82,
   "text": "Next, child's pose."
  },
  "child.now": {
   "file": "child.now.m4a",
   "bytes": 16142,
   "sha256": "454089f66b338bdbc7cec5691eabcd543179e2b98e68f6ae610e2c46cccaa8ec",
   "seconds": 2.69,
   "text": "Now, child's pose."
  },
  "child.enter": {
   "file": "child.enter.m4a",
   "bytes": 76089,
   "sha256": "562a6e9d682ad7660c12e897f1e7194dc5497cdf29bc2328f1b141f10bacb015",
   "seconds": 12.32,
   "text": "Child's pose. Come onto your hands and knees. Sink your hips back toward your heels, and walk your hands forward as your forehead comes down to the mat."
  },
  "child.hold": {
   "file": "child.hold.m4a",
   "bytes": 39631,
   "sha256": "a429e9745d027b5a8586a51fae7831cd8df4f7bff6542b157cfae431578b7161",
   "seconds": 6.41,
   "text": "Rest your forehead, on a cushion if you need one. Breathe into your back."
  },
  "rest.first": {
   "file": "rest.first.m4a",
   "bytes": 16642,
   "sha256": "c080201d5b98669de65e77d38bbe4d4ded69269c1c90dfc9f21ade59bbc54254",
   "seconds": 2.62,
   "text": "Let's begin with rest."
  },
  "rest.next": {
   "file": "rest.next.m4a",
   "bytes": 12646,
   "sha256": "bebb1d023e06e8688c5f552e8e1cc2979a42f263b7444a85f3108698fdaa1a97",
   "seconds": 2.07,
   "text": "Next, rest."
  },
  "rest.now": {
   "file": "rest.now.m4a",
   "bytes": 12025,
   "sha256": "0c2b1718a087d3b5daa4f86ccb6e6e5c6384b94d13426178262667da0bc196ef",
   "seconds": 2.02,
   "text": "Now, rest."
  },
  "rest.enter": {
   "file": "rest.enter.m4a",
   "bytes": 66094,
   "sha256": "3de4ac11a4e7443e7da303665821fe2c7dde663f7fce50e83629d824a67c89ac",
   "seconds": 10.8,
   "text": "Rest. Lie down on your back. Let your legs stretch out, and rest your arms a little away from your body, palms facing up."
  },
  "rest.hold": {
   "file": "rest.hold.m4a",
   "bytes": 39073,
   "sha256": "02dd27c86f0963290e124a7079b6d052523afcad3927f756c554ce81bb96a968",
   "seconds": 6.31,
   "text": "Let your whole body feel heavy. There's nothing to do now but breathe."
  },
  "lunge-left.first": {
   "file": "lunge-left.first.m4a",
   "bytes": 23183,
   "sha256": "7ee5ddd89130d0300b6e116aac354042302a4e5caa8b860209ff329765545e7c",
   "seconds": 3.65,
   "text": "Let's begin with low lunge, left side."
  },
  "lunge-left.next": {
   "file": "lunge-left.next.m4a",
   "bytes": 19104,
   "sha256": "62571d8ac916c6e6f967b04bc6fdf2c5c89176b598fed26e3ea188aaa36bd41e",
   "seconds": 3.1,
   "text": "Next, low lunge, left side."
  },
  "lunge-left.now": {
   "file": "lunge-left.now.m4a",
   "bytes": 18495,
   "sha256": "b4b51d983f4fabb5826bed3d3958142e41f3f959e60f6da75a12359b6e672765",
   "seconds": 3.04,
   "text": "Now, low lunge, left side."
  },
  "lunge-left.enter": {
   "file": "lunge-left.enter.m4a",
   "bytes": 77235,
   "sha256": "ceda001e81fbfeea6108516eee8ac29063634e010befc184436fe89ceacd621d",
   "seconds": 12.53,
   "text": "Low lunge, left side. Step your left foot forward between your hands, and lower your right knee onto the mat, with some padding if you like. Lift your chest."
  },
  "lunge-left.hold": {
   "file": "lunge-left.hold.m4a",
   "bytes": 46768,
   "sha256": "54182b8c4baff7cf8bf2b4a70024264db89bbe66f402e2550cff83d2c3f3643a",
   "seconds": 7.38,
   "text": "Let your hips sink gently forward. Keep your front knee above your ankle, and breathe."
  },
  "lunge-right.first": {
   "file": "lunge-right.first.m4a",
   "bytes": 22929,
   "sha256": "d32884073de785e61a831ce885700f268e7116b317b102b6e7b10353032b66c2",
   "seconds": 3.67,
   "text": "Let's begin with low lunge, right side."
  },
  "lunge-right.next": {
   "file": "lunge-right.next.m4a",
   "bytes": 19018,
   "sha256": "e544bc728f3d1f0f25befead7f28fd56e743f16c7d6413d374f0bdf2cd7dd225",
   "seconds": 3.1,
   "text": "Next, low lunge, right side."
  },
  "lunge-right.now": {
   "file": "lunge-right.now.m4a",
   "bytes": 18739,
   "sha256": "5831493ab3625f295ed973c3d45bd036d95cb3bd30db3aa582fc975b1e5837f5",
   "seconds": 3.1,
   "text": "Now, low lunge, right side."
  },
