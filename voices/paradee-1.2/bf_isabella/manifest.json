   "sha256": "d8463b698f6218c956b8616ffc9f98300638c91ddf0921fc08d412a2f2fec739",
   "seconds": 3.52,
   "text": "Now, triangle pose, left side."
  },
  "triangle-left.enter": {
   "file": "triangle-left.enter.m4a",
   "bytes": 103371,
   "sha256": "28c2ac35d6a18138411f164b5ffa86e67c4cfe36fa298e4353c1e719de49378b",
   "seconds": 16.1,
   "text": "Triangle pose, left side. With your feet wide, turn your left foot out and straighten both legs. Reach forward over your left leg, rest your lower hand on your shin or a block, and lift your other arm toward the sky."
  },
  "triangle-left.hold": {
   "file": "triangle-left.hold.m4a",
   "bytes": 45686,
   "sha256": "a5f0665914eb16307c506285378d3593357864ae2dba12ddb473d63789180790",
   "seconds": 6.93,
   "text": "Keep both sides of your waist long. Look up only if your neck feels comfortable."
  },
  "triangle-right.first": {
   "file": "triangle-right.first.m4a",
   "bytes": 25738,
   "sha256": "b53e5e6820a30b9f737c3f6857edaa509e06c31a38be3bbdce3ba88daa0da7bf",
   "seconds": 4.02,
   "text": "Let's begin with triangle pose, right side."
  },
  "triangle-right.next": {
   "file": "triangle-right.next.m4a",
   "bytes": 22659,
   "sha256": "c5d6f899464eaf283496315604b3fdc6bf19a205def60463aac72ab37133d75e",
   "seconds": 3.57,
   "text": "Next, triangle pose, right side."
  },
  "triangle-right.now": {
   "file": "triangle-right.now.m4a",
   "bytes": 21442,
   "sha256": "873f716d8a8f38d41b5fad86d5707c8cee55794429b1676061a7ade12ed531a9",
   "seconds": 3.47,
   "text": "Now, triangle pose, right side."
  },
  "triangle-right.enter": {
   "file": "triangle-right.enter.m4a",
   "bytes": 102845,
   "sha256": "a9b3729b367d47da3327466ec7508e16004eb74ea52097ce0d60860ce724ba87",
   "seconds": 16.2,
   "text": "Triangle pose, right side. With your feet wide, turn your right foot out and straighten both legs. Reach forward over your right leg, rest your lower hand on your shin or a block, and lift your other arm toward the sky."
  },
  "triangle-right.hold": {
